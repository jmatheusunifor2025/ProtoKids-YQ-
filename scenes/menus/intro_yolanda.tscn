[sub_resource type="Shader" id="Desfoque"]
code = "shader_type canvas_item;
// Desfoque gaussiano do fundo (21x21 amostras) e um leve escurecimento.
uniform float passo = 2.0;
uniform float escurecer : hint_range(0.0, 1.0) = 0.3;

void fragment() {
	vec3 soma = vec3(0.0);
	float pesos = 0.0;
	for (int x = -10; x <= 10; x++) {
		for (int y = -10; y <= 10; y++) {
			float peso = exp(-float(x * x + y * y) / 50.0);
			soma += texture(TEXTURE, UV + vec2(float(x), float(y)) * TEXTURE_PIXEL_SIZE * passo).rgb * peso;
			pesos += peso;
		}
	}
	COLOR = vec4(soma / pesos * (1.0 - escurecer), 1.0);
}
"

[sub_resource type="ShaderMaterial" id="FundoDesfocado"]
shader = SubResource("Desfoque")
shader_parameter/passo = 2.0
shader_parameter/escurecer = 0.3

